<Window x:Class="ProfessionalPowerCopyCatalogModern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mold Automation Catalog" Width="1320" Height="820"
        MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="126"/>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Modern product navigation -->
        <Border Grid.Column="0" Background="{StaticResource Navy}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="116"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="118"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="54" Height="54" CornerRadius="15" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#1D4ED8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image x:Name="BrandLogo" Source="{x:Null}" Stretch="Uniform" Margin="6"
                                   Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="BrandInitials" Text="PC" Foreground="White" FontSize="17" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="MOLD TOOLS" Foreground="#CBD5E1" FontSize="9" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Product areas -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button x:Name="PowerCopiesNavButton" Style="{StaticResource SideNavButton}" Tag="Selected"
                            ToolTip="Browse Power Copies" Click="PowerCopiesNavButton_OnClick">
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="30" Height="27" HorizontalAlignment="Center">
                                <Border Width="22" Height="13" CornerRadius="3" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        BorderThickness="1.6" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,0,0,0"/>
                                <Border Width="22" Height="13" CornerRadius="3" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        BorderThickness="1.6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Border Width="22" Height="13" CornerRadius="3" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        BorderThickness="1.6" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Power Copies" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontSize="10" FontWeight="SemiBold" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="AboutNavButton" Style="{StaticResource SideNavButton}"
                            ToolTip="About, support and access rights" Click="AboutNavButton_OnClick">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1.7">
                                <TextBlock Text="i" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontFamily="Georgia" FontSize="17" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                            <TextBlock Text="About" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontSize="10" FontWeight="SemiBold" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- License footer -->
                <Border Grid.Row="2" Background="#111C31" CornerRadius="12" Margin="12,12,12,18" Padding="10">
                    <StackPanel>
                        <TextBlock Text="CURRENT ACCESS" Foreground="#64748B" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
                            <Ellipse x:Name="AccessDot" Width="7" Height="7" Fill="#22C55E" Margin="0,0,6,0"/>
                            <TextBlock x:Name="AccessStatusText" Text="Licensed" Foreground="#D1FAE5" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="LicenseTimeText" Text="—" Foreground="#64748B" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Catalog list -->
        <Border x:Name="CatalogPane" Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid Margin="24,20,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Power Copy Library" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Choose a verified engineering template" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" x:Name="ConnectionPill" Background="#FEE2E2" CornerRadius="14" Padding="10,6" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#DC2626" Margin="0,0,7,0"/>
                            <TextBlock x:Name="ConnectionText" Text="CATIA offline" FontSize="11" Foreground="#991B1B"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="White" CornerRadius="11" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,22,0,0" Height="46">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#94A3B8" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="13" Foreground="{StaticResource Slate}"
                                 TextChanged="SearchBox_OnTextChanged" ToolTip="Search templates"/>
                        <Button x:Name="RefreshCatalogButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                                Margin="6,0,0,0" Padding="12,6" Click="RefreshCatalogButton_OnClick"
                                ToolTip="Check the license server for new or updated Power Copies">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <WrapPanel Grid.Row="2" Margin="0,16,0,7">
                    <Button x:Name="AllCategoryButton" Content="All" Style="{StaticResource CategoryChip}" Tag="Selected" Click="CategoryButton_OnClick"/>
                    <Button x:Name="DogHousesCategoryButton" Content="Dog Houses" Style="{StaticResource CategoryChip}" Click="CategoryButton_OnClick"/>
                    <Button x:Name="ClipsCategoryButton" Content="Clips" Style="{StaticResource CategoryChip}" Click="CategoryButton_OnClick"/>
                    <Button x:Name="RibsCategoryButton" Content="Ribs" Style="{StaticResource CategoryChip}" Click="CategoryButton_OnClick"/>
                    <Button x:Name="BossesCategoryButton" Content="Bosses" Style="{StaticResource CategoryChip}" Click="CategoryButton_OnClick"/>
                    <Button x:Name="LiftersCategoryButton" Content="Lifters" Style="{StaticResource CategoryChip}" Click="CategoryButton_OnClick"/>
                    <Button x:Name="FavoritesCategoryButton" Content="★ Favorites" Style="{StaticResource CategoryChip}" Click="CategoryButton_OnClick"/>
                </WrapPanel>

                <ListBox x:Name="CatalogList" Grid.Row="3" BorderThickness="0" Background="Transparent"
                         ItemsSource="{Binding CatalogItems}" SelectionChanged="CatalogList_OnSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0,0,0,12"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Card" Background="White" CornerRadius="14" Padding="12"
                                                BorderBrush="#E2E8F0" BorderThickness="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#93C5FD"/>
                                                <Setter TargetName="Card" Property="Background" Value="#FCFDFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="#2563EB"/>
                                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="Card" Property="Background" Value="#EFF6FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="104">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="138"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="10" ClipToBounds="True" Background="#E2E8F0">
                                    <Image Source="{Binding ThumbnailFullPath}" Stretch="UniformToFill"/>
                                </Border>
                                <Grid Grid.Column="1" Margin="15,2,2,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,28,0"/>
                                    <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Width="25" Height="25"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            CommandParameter="{Binding}" Click="FavoriteButton_OnClick" ToolTip="Add or remove favorite">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="☆"/>
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                <Setter Property="FontSize" Value="17"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Content" Value="★"/>
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{StaticResource Muted}"
                                               FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                                        <Border Background="#E0E7FF" CornerRadius="9" Padding="8,3" Margin="0,0,7,0">
                                            <TextBlock Text="{Binding Category}" Foreground="#4338CA" FontSize="9"/>
                                        </Border>
                                        <Border Background="#E2E8F0" CornerRadius="9" Padding="8,3">
                                            <TextBlock Text="{Binding Version, StringFormat=v{0}}" Foreground="#475569" FontSize="9"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Detail workspace -->
        <ScrollViewer x:Name="DetailPane" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,22,34,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Template details" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedItem.Name}" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#ECFDF5" CornerRadius="16" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#15803D" Margin="0,0,7,0"/>
                                <TextBlock Text="Verified template" Foreground="#166534" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="LifterWorkflowBadge" Background="#EFF6FF" CornerRadius="16" Padding="12,7"
                                Margin="8,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" Foreground="#2563EB" Margin="0,0,7,0"/>
                                <TextBlock Text="Lifter workflow" Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="0,24,0,0" CornerRadius="18" ClipToBounds="True" Background="#CBD5E1" Height="285">
                    <Grid>
                        <Image Source="{Binding SelectedItem.ThumbnailFullPath}" Stretch="UniformToFill"/>
                        <Border VerticalAlignment="Bottom" Height="80">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00111B2B" Offset="0"/>
                                    <GradientStop Color="#CC0F172A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="20,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedItem.Category}" Foreground="#BFDBFE" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedItem.Name}" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#334155" CornerRadius="10" Padding="10,5">
                                    <TextBlock Text="{Binding SelectedItem.Version, StringFormat=Version {0}}" Foreground="White" FontSize="10"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="14" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ABOUT THIS CHECK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding SelectedItem.Description}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="21" Foreground="{StaticResource Slate}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ENGINEERING INTERFACE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="Inputs" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding SelectedItem.Inputs}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock Text="Output" FontWeight="SemiBold" Margin="0,11,0,0"/>
                            <TextBlock Text="{Binding SelectedItem.Output}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,22,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="UseInCatiaButton" Style="{StaticResource PrimaryButton}" Click="UseInCatiaButton_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock Text="Use in CATIA" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RunCheckButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Background="#0F766E"
                            Click="RunCheckButton_OnClick" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock Text="Run check" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CloseSourceButton" Grid.Column="4" Style="{StaticResource SecondaryButton}"
                            Click="CloseSourceButton_OnClick" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/>
                            <TextBlock Text="Close source"/>
                        </StackPanel>
                    </Button>
                    <Grid Grid.Row="1" Grid.ColumnSpan="5" Margin="2,10,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="#64748B" Margin="0,0,7,0"/>
                            <TextBlock x:Name="PackageStatusText" Text="Secure server package will download on first use."
                                       Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="ClearPackageCacheButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                Padding="10,5" Click="ClearPackageCacheButton_OnClick" ToolTip="Delete the local copy so the next use measures a fresh download">
                            <TextBlock Text="Clear cache" FontSize="10"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                Padding="10,5" Click="OpenPackageSpeedLogButton_OnClick" ToolTip="Open the CSV download and cache performance log">
                            <TextBlock Text="Speed log" FontSize="10"/>
                        </Button>
                    </Grid>
                </Grid>

                <Border Grid.Row="4" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,24,0,0" Padding="20">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Latest check" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatusText" Text="Insert the template, then run the integrated check." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="12" Padding="11,6" VerticalAlignment="Center">
                                <TextBlock x:Name="OverallStatusText" Text="NOT RUN" Foreground="#1D4ED8" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <ItemsControl x:Name="ResultsItems" ItemsSource="{Binding Results}" Margin="0,18,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBackground}" CornerRadius="12" Padding="15" Margin="0,0,12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" Background="White" Opacity="0.8">
                                                <TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusForeground}" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Position, StringFormat=Slider {0}}" FontWeight="SemiBold" Foreground="{Binding StatusForeground}"/>
                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding StatusForeground}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Distance}" FontSize="10" Foreground="{Binding StatusForeground}" Opacity="0.78" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding NearestBody, StringFormat=Nearest: {0}}" FontSize="9" Foreground="{Binding StatusForeground}" Opacity="0.68" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- In-dashboard About / Account workspace -->
        <Grid x:Name="AboutWorkspace" Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource Canvas}" Visibility="Collapsed" Panel.ZIndex="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="36,26,40,34" MaxWidth="1050" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="About &amp; Account" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock Text="Product information, current access and support" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Click="SignOutButton_OnClick" Padding="14,10" Margin="0,0,8,0"><TextBlock Text="Sign out"/></Button>
                            <Button Style="{StaticResource SecondaryButton}" Click="BackToLibraryButton_OnClick" Padding="16,10"><TextBlock Text="←  Back to library" FontWeight="SemiBold"/></Button>
                        </StackPanel>
                    </Grid>

                    <!-- Profile hero -->
                    <Border Grid.Row="1" CornerRadius="18" Margin="0,24,0,0" Padding="26">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0F172A" Offset="0"/>
                                <GradientStop Color="#172554" Offset="0.65"/>
                                <GradientStop Color="#1D4ED8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="72" Height="72" CornerRadius="20" Background="#2563EB">
                                <TextBlock Text="PU" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="AboutUserNameText" Text="Prototype User" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AboutUserPlanText" Text="Developer Preview • Individual workspace" Foreground="#BFDBFE" Margin="0,5,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,7,0"/>
                                    <TextBlock Text="Active session" Foreground="#BBF7D0" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="230">
                                <Border Background="#263B66" CornerRadius="11" Padding="13,8" Margin="0,0,0,8">
                                    <Grid><TextBlock Text="CATIA" Foreground="#93C5FD"/><TextBlock x:Name="AboutCatiaStatusText" Text="Connected" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                                </Border>
                                <Border Background="#263B66" CornerRadius="11" Padding="13,8">
                                    <Grid><TextBlock Text="Active document" Foreground="#93C5FD"/><TextBlock x:Name="AboutDocumentText" Text="—" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" MaxWidth="135" TextTrimming="CharacterEllipsis"/></Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Privileges -->
                    <Grid Grid.Row="2" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="White" CornerRadius="15" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="12" Background="#DBEAFE" HorizontalAlignment="Left">
                                    <TextBlock Text="PC" Foreground="#1D4ED8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Power Copy Library" FontSize="15" FontWeight="SemiBold" Margin="0,15,0,0"/>
                                <TextBlock Text="Browse and launch verified CATIA engineering templates." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Border Background="#DCFCE7" CornerRadius="9" Padding="8,4" HorizontalAlignment="Left" Margin="0,15,0,0"><TextBlock Text="ENABLED" Foreground="#166534" FontSize="9" FontWeight="Bold"/></Border>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="White" CornerRadius="15" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="12" Background="#CCFBF1" HorizontalAlignment="Left">
                                    <TextBlock Text="✓" Foreground="#0F766E" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Integrated Checks" FontSize="15" FontWeight="SemiBold" Margin="0,15,0,0"/>
                                <TextBlock Text="Run CATIA interference scripts and display synchronized results." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Border Background="#DCFCE7" CornerRadius="9" Padding="8,4" HorizontalAlignment="Left" Margin="0,15,0,0"><TextBlock Text="ENABLED" Foreground="#166534" FontSize="9" FontWeight="Bold"/></Border>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="White" CornerRadius="15" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="12" Background="#FFEDD5" HorizontalAlignment="Left">
                                    <TextBlock Text="PKG" Foreground="#C2410C" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Protected Packages" FontSize="15" FontWeight="SemiBold" Margin="0,15,0,0"/>
                                <TextBlock Text="Encrypted templates, online entitlements and controlled updates." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <Border Background="#FEF3C7" CornerRadius="9" Padding="8,4" HorizontalAlignment="Left" Margin="0,15,0,0"><TextBlock Text="PLANNED" Foreground="#92400E" FontSize="9" FontWeight="Bold"/></Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Contact and product -->
                    <Grid Grid.Row="3" Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="White" CornerRadius="15" BorderBrush="#E2E8F0" BorderThickness="1" Padding="21">
                            <StackPanel>
                                <TextBlock Text="Contact &amp; Support" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="Need help with a template, CATIA compatibility or your account?" Foreground="{StaticResource Muted}" Margin="0,6,0,15" TextWrapping="Wrap"/>
                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="EmailSupportButton_OnClick"><TextBlock Text="support@yourcompany.com"/></Button>
                                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" Margin="0,7,0,0" Click="WebsiteButton_OnClick"><TextBlock Text="www.yourcompany.com"/></Button>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="White" CornerRadius="15" BorderBrush="#E2E8F0" BorderThickness="1" Padding="21">
                            <StackPanel>
                                <TextBlock Text="Product information" FontSize="17" FontWeight="SemiBold"/>
                                <Grid Margin="0,15,0,0"><TextBlock Text="Application" Foreground="{StaticResource Muted}"/><TextBlock Text="Mold Automation Catalog" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                                <Grid Margin="0,10,0,0"><TextBlock Text="Version" Foreground="{StaticResource Muted}"/><TextBlock Text="1.0.0 Prototype" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                                <Grid Margin="0,10,0,0"><TextBlock Text="License plan" Foreground="{StaticResource Muted}"/><TextBlock Text="Developer Preview" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                                <Grid Margin="0,10,0,0"><TextBlock Text="Template source" Foreground="{StaticResource Muted}"/><TextBlock Text="Local catalog.json" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Login overlay: customer and admin use the same authenticated client -->
        <Grid x:Name="LoginOverlay" Grid.Column="0" Grid.ColumnSpan="3" Panel.ZIndex="50">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EFF6FF" Offset="0"/><GradientStop Color="#F8FAFC" Offset="0.5"/><GradientStop Color="#E0E7FF" Offset="1"/></LinearGradientBrush>
            </Grid.Background>
            <Border Width="450" Background="White" CornerRadius="22" Padding="34" BorderBrush="#DBE3EE" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.16" Color="#0F172A"/></Border.Effect>
                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="18" Background="#2563EB" HorizontalAlignment="Center">
                        <Grid>
                            <Image x:Name="LoginBrandLogo" Source="{x:Null}" Stretch="Uniform" Margin="8" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="LoginBrandInitials" Text="PC" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Welcome to Mold Tools" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Text="Sign in to access your licensed Power Copy catalog" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,7,0,22"/>
                    <TextBlock Text="Email" FontSize="10" FontWeight="Bold"/><TextBox x:Name="LoginEmailBox" Height="42" Padding="11" Margin="0,6,0,13"/>
                    <TextBlock Text="Password" FontSize="10" FontWeight="Bold"/><PasswordBox x:Name="LoginPasswordBox" Height="42" Padding="11" Margin="0,6,0,10"/>
                    <CheckBox x:Name="RememberMeCheck" Content="Remember me" IsChecked="True" FontSize="12" Margin="0,0,0,10"/>
                    <Button x:Name="LoginButton" Style="{StaticResource PrimaryButton}" Click="LoginButton_OnClick"><TextBlock Text="Sign in" Foreground="White" FontSize="14"/></Button>
                    <TextBlock x:Name="LoginStatusText" Foreground="#B91C1C" TextWrapping="Wrap" TextAlignment="Center" Margin="0,13,0,0"/>
                    <TextBlock Text="Secure online license • device-bound session" Foreground="#94A3B8" FontSize="9" HorizontalAlignment="Center" Margin="0,19,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
