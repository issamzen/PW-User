<Window x:Class="ProfessionalPowerCopyCatalogModern.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PW-User — PowerCopy library" Width="1060" Height="680"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <LinearGradientBrush x:Key="RailBrush" StartPoint="0,0" EndPoint="0.6,1">
            <GradientStop Color="#0B1220" Offset="0"/>
            <GradientStop Color="#102A36" Offset="0.55"/>
            <GradientStop Color="#0C3B45" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0"/>
            <GradientStop Color="#155E75" Offset="0.6"/>
            <GradientStop Color="#0F8891" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#0F8891"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" CornerRadius="10" Background="{TemplateBinding Background}"
                                Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#9FB6C4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" CornerRadius="8" Padding="12,8" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#16324055"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Shell" Property="Background" Value="#16A7B4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- premium catalog card -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" CornerRadius="14" Background="White" BorderBrush="#E6ECF2"
                                BorderThickness="1" Padding="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.07" Color="#0F172A"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="12" Background="#E6F6F8">
                                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                               Foreground="#0F8891" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10" Foreground="#64748B" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Id}"/><Run Text="  •  "/><Run Text="{Binding Category}"/><Run Text="  •  v"/><Run Text="{Binding Version}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#94A3B8"
                                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis" MaxHeight="28"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#16A7B4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#0F8891"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Card" Property="Background" Value="#F7FDFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#F4F7FA" BorderBrush="#D7E1EA" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.25" Color="#0F172A"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- ================= left rail ================= -->
            <Border CornerRadius="16,0,0,16" Background="{StaticResource RailBrush}">
                <DockPanel Margin="16,18,16,16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#16A7B4">
                            <TextBlock Text="PW" Foreground="White" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PowerCopy library" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RailSubText" Text="Licensed templates" Foreground="#7E96A5" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Top" CornerRadius="9" Background="#16324055" Padding="10,7" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#7E96A5" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Margin="8,0,0,0" BorderThickness="0"
                                     Background="Transparent" Foreground="White" CaretBrush="White" FontSize="11"
                                     TextChanged="SearchBox_OnTextChanged"/>
                        </Grid>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" Foreground="#5C7384" FontSize="9"
                               FontWeight="Bold" Margin="4,0,0,8"/>
                    <StackPanel x:Name="CategoryPanel" DockPanel.Dock="Top"/>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Border CornerRadius="10" Background="#16324055" Padding="11" Margin="0,10,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="CatiaDot" Width="8" Height="8" Fill="#DC2626" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="CatiaText" Text="CATIA offline" Foreground="#9FB6C4" FontSize="10"
                                               Margin="7,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="LicenseText" Text="" Foreground="#5C7384" FontSize="9" Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid/>
                </DockPanel>
            </Border>

            <!-- ================= catalog ================= -->
            <DockPanel Grid.Column="1" Margin="18,16,10,16">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Verified engineering templates" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock x:Name="CountText" Text="" FontSize="10" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource PillButton}" Width="104" Height="30" Background="#E2E8F0"
                                Foreground="#0F172A" Click="RefreshButton_OnClick" Content="Refresh"/>
                        <Button Style="{StaticResource PillButton}" Width="36" Height="30" Margin="8,0,0,0"
                                Background="#E2E8F0" Foreground="#0F172A" Click="Close_OnClick" Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" ToolTip="Close the library (the toolbar stays)"/>
                    </StackPanel>
                </Grid>

                <ListBox x:Name="CatalogList" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource CardItem}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="CatalogList_OnSelectionChanged"/>
            </DockPanel>

            <!-- ================= detail ================= -->
            <Border Grid.Column="2" CornerRadius="0,16,16,0" Background="White" BorderBrush="#E6ECF2" BorderThickness="1,0,0,0">
                <DockPanel Margin="0">
                    <Border DockPanel.Dock="Top" CornerRadius="0,16,0,0" Background="{StaticResource HeroBrush}" Padding="18,16">
                        <StackPanel>
                            <TextBlock x:Name="DetailKicker" Text="SELECTED TEMPLATE" Foreground="#93E4EC" FontSize="9" FontWeight="Bold"/>
                            <TextBlock x:Name="DetailTitle" Text="No template selected" Foreground="White" FontSize="16"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="DetailMeta" Text="Pick a card on the left" Foreground="#A9D6DE" FontSize="10"
                                       Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <Border x:Name="LifterBadge" CornerRadius="8" Background="#1D4ED8" Padding="8,3" Margin="0,9,0,0"
                                    HorizontalAlignment="Left" Visibility="Collapsed">
                                <TextBlock Text="LIFTER WORKFLOW" Foreground="White" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" Padding="16,10">
                        <StackPanel>
                            <TextBlock x:Name="StatusText" Text="Ready." FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PackageText" Text="" FontSize="9" Foreground="#94A3B8" Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="16,14,16,10">
                        <Button x:Name="UseButton" Style="{StaticResource PillButton}" Click="UseButton_OnClick"
                                IsEnabled="False" Height="42">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" Foreground="White"/>
                                <TextBlock Text="Use in CATIA" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="CheckButton" Style="{StaticResource PillButton}" Click="CheckButton_OnClick"
                                Background="#0F766E" Margin="0,8,0,0" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" Foreground="White"/>
                                <TextBlock Text="Run feasibility check" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="DETAILS" FontSize="9" FontWeight="Bold" Foreground="#0F8891" Margin="2,16,0,6"/>
                        <Border CornerRadius="10" Background="#F8FAFC" BorderBrush="#E6ECF2" BorderThickness="1" Padding="12">
                            <StackPanel>
                                <TextBlock x:Name="DetailDescription" Text="—" FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailInputs" Text="" FontSize="10" Foreground="#64748B" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailOutput" Text="" FontSize="10" Foreground="#64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- drag strip on the top of the catalog area -->
            <Border Grid.Column="1" Grid.ColumnSpan="2" Height="16" VerticalAlignment="Top" Background="Transparent"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown"/>
        </Grid>
    </Border>
</Window>
