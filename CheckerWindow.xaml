<Window x:Class="ProfessionalPowerCopyCatalogModern.CheckerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PW-User — Checker" Width="470" Height="430"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Border CornerRadius="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.22" Color="#0F172A"/>
        </Border.Effect>
        <DockPanel>
            <Border DockPanel.Dock="Top" CornerRadius="14,14,0,0" Padding="16,13"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0F172A" Offset="0"/>
                        <GradientStop Color="#7F1D1D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#C0392B">
                            <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Feasibility checker" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SubText" Text="PowerCopy vs main CATPart" Foreground="#FCA5A5" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FCA5A5"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                               MouseLeftButtonDown="Close_OnMouseLeftButtonDown"/>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" CornerRadius="0,0,14,14" Background="#F8FAFC" Padding="14,10">
                <Grid>
                    <TextBlock x:Name="StatusText" Text="Ready." FontSize="10" Foreground="#64748B"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,96,0"/>
                    <Button Content="Run check" HorizontalAlignment="Right" Width="88" Height="28"
                            Background="#C0392B" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="RunButton_OnClick" FontSize="11" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid Margin="14,12,14,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border CornerRadius="10" Background="#F8FAFC" BorderBrush="#E6ECF2" BorderThickness="1" Padding="12">
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="TemplateText" Text="No template selected" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock x:Name="DocumentText" Text="No destination CATPart" FontSize="10"
                                       Foreground="#64748B" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border x:Name="VerdictBadge" CornerRadius="8" Padding="10,5" Background="#E2E8F0"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="VerdictText" Text="NOT RUN" FontSize="10" FontWeight="Bold" Foreground="#334155"/>
                        </Border>
                    </Grid>
                </Border>

                <ListBox x:Name="ResultList" Grid.Row="1" Margin="0,10,0,0" BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border CornerRadius="10" Background="White" BorderBrush="#E6ECF2"
                                                BorderThickness="1" Padding="10">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="8" Background="{Binding StatusBackground}">
                                    <TextBlock Text="{Binding StatusGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{Binding StatusForeground}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Position}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding NearestBody}" FontSize="9" Foreground="#94A3B8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{Binding StatusForeground}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding Distance}" FontSize="9" Foreground="#64748B"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Border>
</Window>
